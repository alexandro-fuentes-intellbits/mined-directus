{
    "name": "directus-extension-ui-customization",
    "version": "1.0.0",
    "description": "Branding and UI cleanup to remove Directus name and hide unneeded sidebar items.",
    "type": "module",
    "directus:extension": {
        "type": "hook",
        "path": "dist/index.js",
        "source": "src/index.js",
        "host": "^11.0.0"
    },
    "scripts": {
        "build": "npx --yes @directus/extensions-sdk@latest build",
        "dev": "npx --yes @directus/extensions-sdk@latest build -w --no-minify"
    },
    "devDependencies": {
        "@directus/extensions-sdk": "^12.0.0"
    }
}