{
    "name": "directus-extension-video-fix-endpoint",
    "version": "1.0.0",
    "description": "Endpoint para corregir MIME types de videos existentes en la base de datos",
    "type": "module",
    "directus:extension": {
        "type": "endpoint",
        "path": "dist/index.js",
        "source": "src/index.js",
        "host": "^11.0.0"
    },
    "scripts": {
        "build": "npx --yes @directus/extensions-sdk@latest build",
        "dev": "npx --yes @directus/extensions-sdk@latest build -w --no-minify"
    },
    "devDependencies": {
        "@directus/extensions-sdk": "^12.0.0"
    }
}