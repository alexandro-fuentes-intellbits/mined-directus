{
    "name": "directus-extension-gcs-video-player",
    "version": "1.0.0",
    "description": "Interfaz personalizada para previsualizar y reproducir videos MP4 almacenados en Google Cloud Storage a través de Directus",
    "keywords": [
        "directus",
        "directus-extension",
        "directus-custom-interface",
        "video-player",
        "gcs"
    ],
    "type": "module",
    "directus:extension": {
        "type": "interface",
        "path": "dist/index.js",
        "source": "src/index.js",
        "host": "^11.0.0"
    },
    "scripts": {
        "build": "npx --yes @directus/extensions-sdk@latest build",
        "dev": "npx --yes @directus/extensions-sdk@latest build -w --no-minify"
    },
    "devDependencies": {
        "@directus/extensions-sdk": "^12.0.0",
        "vue": "^3.4.0"
    }
}